# Godot 3.x legacy cache (safe to keep if migrating)
.import/

# Automatically generated translation binaries (keep source .csv/.po files!)
*.translation

# Windows hot-reload DLL copies (Godot 4.2+)
~*.dll

# ==========================================
# CREDENTIALS & LOCAL EXPORT CONFIGS
# ==========================================
